{
  "name": "ai-sdk-guardrails",
  "version": "6.2.0",
  "description": "Input and output guardrails middleware for Vercel AI SDK.",
  "keywords": [
    "ai",
    "guardrails",
    "vercel-ai-sdk",
    "typescript",
    "validation",
    "safety",
    "streaming",
    "security",
    "content-filtering",
    "prompt-injection",
    "ai-safety"
  ],
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./guardrails/input": {
      "types": "./dist/guardrails/input.d.ts",
      "import": "./dist/guardrails/input.js",
      "require": "./dist/guardrails/input.cjs"
    },
    "./guardrails/output": {
      "types": "./dist/guardrails/output.d.ts",
      "import": "./dist/guardrails/output.js",
      "require": "./dist/guardrails/output.cjs"
    },
    "./guardrails/tools": {
      "types": "./dist/guardrails/tools.d.ts",
      "import": "./dist/guardrails/tools.js",
      "require": "./dist/guardrails/tools.cjs"
    },
    "./governance": {
      "types": "./dist/governance/index.d.ts",
      "import": "./dist/governance/index.js",
      "require": "./dist/governance/index.cjs"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "import": "./dist/config/index.js",
      "require": "./dist/config/index.cjs"
    },
    "./advanced": {
      "types": "./dist/advanced/index.d.ts",
      "import": "./dist/advanced/index.js",
      "require": "./dist/advanced/index.cjs"
    }
  },
  "homepage": "https://github.com/jagreehal/ai-sdk-guardrails",
  "bugs": {
    "url": "https://github.com/jagreehal/ai-sdk-guardrails/issues"
  },
  "author": "Jag Reehal<jag@jagreehal.com> (https://jagreehal.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jagreehal/ai-sdk-guardrails.git"
  },
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsup",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "check-exports": "pnpm pack --out attw.tgz >/dev/null && attw attw.tgz --ignore-rules false-esm no-resolution; s=$?; rm -f attw.tgz; exit $s",
    "test:coverage": "vitest run --coverage",
    "bench": "vitest run bench",
    "bench:update": "BENCH_UPDATE=1 vitest run bench"
  },
  "dependencies": {
    "@ai-sdk/provider": "^4.0.36",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.10.0",
    "ai": "^7.0.163",
    "autotel-genai": ">=0.4.2"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "autotel-genai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/groq": "4.0.77",
    "@ai-sdk/mistral": "4.0.80",
    "@ai-sdk/openai": "4.0.109",
    "@arethetypeswrong/cli": "0.18.5",
    "@oxlint/plugins": "1.90.0",
    "@total-typescript/ts-reset": "0.6.1",
    "@total-typescript/tsconfig": "1.0.4",
    "@types/node": "26.6.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "5.0.5",
    "ai": "7.0.163",
    "oxlint": "1.90.0",
    "prettier": "3.9.10",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "5.0.5"
  }
}
